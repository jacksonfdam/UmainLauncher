<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A launcher theme must let the system wallpaper show through, so the window
      background is transparent and windowShowWallpaper is enabled. Compose draws
      everything else on top.
    -->
    <style name="Theme.UmainLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
